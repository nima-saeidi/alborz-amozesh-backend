SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=alborz-institute.com,www.alborz-institute.com,localhost,127.0.0.1

# PostgreSQL
DB_NAME=alborz
DB_USER=alborz
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
# Or any database URL instead of DB_* (e.g. for local tests): DATABASE_URL=sqlite:///db.sqlite3

# Frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=https://alborz-institute.com,https://www.alborz-institute.com,http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://alborz-institute.com,https://www.alborz-institute.com

# Session videos / pdfs are served by nginx (X-Accel-Redirect) in production
PROTECTED_MEDIA_USE_ACCEL=True
